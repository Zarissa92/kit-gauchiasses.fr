# Modèle d'unité systemd : installer_systemd.sh remplace les __MARQUEURS__ et la copie dans /etc/systemd/system/.
[Unit]
Description=Construction de la veille gauchiasses.fr et copie dans public/
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=__UTILISATEUR__
Group=__GROUPE__
WorkingDirectory=__DOSSIER__
ExecStart=__DOSSIER__/venv/bin/python __DOSSIER__/bin/publier_public.py
TimeoutStartSec=900
Nice=10
# Journal : journalctl -u gauchiasses-veille.service
